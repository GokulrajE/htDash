{
  "adl": {
    "description": "Activities of Daily Living Exercises",
    "exercises": [
      {
        "id": "adl_1",
        "name": "Reaching Exercise",
        "name_hi": "पहुंचने का अभ्यास",
        "name_ta": "அடைதல் பயிற்சி",
        "description": "Reach forward to touch target object",
        "description_hi": "लक्ष्य वस्तु को छूने के लिए आगे बढ़ें",
        "description_ta": "இலக்கு பொருளைத் தொடுவதற்கு முன் செல்லுங்கள்",
        "category": "reaching"
      },
      {
        "id": "adl_2",
        "name": "Grasping Exercise",
        "name_hi": "पकड़ने का अभ्यास",
        "name_ta": "பிடித்தல் பயிற்சி",
        "description": "Grip and release small objects",
        "description_hi": "छोटी वस्तुओं को पकड़ें और छोड़ें",
        "description_ta": "சிறிய பொருட்களைப் பிடித்து விடுங்கள்",
        "category": "grasping"
      },
      {
        "id": "adl_3",
        "name": "Turning Pages",
        "name_hi": "पन्ने पलटने का अभ्यास",
        "name_ta": "பக்கங்களைப் புரட்டுதல் பயிற்சி",
        "description": "Flip through book pages",
        "description_hi": "किताब के पन्ने पलटें",
        "description_ta": "புத்தல் பக்கங்களைப் புரட்சிக்கவும்",
        "category": "fine_motor"
      },
      {
        "id": "adl_4",
        "name": "Using Phone",
        "name_hi": "फोन का उपयोग",
        "name_ta": "போனைப் பயன்படுத்துதல்",
        "description": "Operate smartphone touchscreen",
        "description_hi": "स्मार्टफोन की स्क्रीन का उपयोग करें",
        "description_ta": "ஸ்மார்ட்ஃபோன் திரை இயக்கவும்",
        "category": "fine_motor"
      },
      {
        "id": "adl_5",
        "name": "Drinking Glass",
        "name_hi": "गिलास पकड़ना",
        "name_ta": "கண்ணாடியைப் பிடித்தல்",
        "description": "Lift and hold glass to mouth",
        "description_hi": "गिलास को उठाकर मुंह तक ले जाएं",
        "description_ta": "கண்ணாடியைத் தூக்கி வாய்க்குக் கொண்டுவரவும்",
        "category": "reaching"
      }
    ]
  },
  "vcg": {
