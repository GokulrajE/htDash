        },
        {
          "id": "vcg3_2",
          "name": "Finger Spread",
          "name_hi": "उंगली फैलाव",
          "name_ta": "விரல் பரப்புதல்",
          "description": "Spread fingers apart",
          "description_hi": "उंगलियों को अलग करें",
          "description_ta": "விரல்களைப் பிரித்துக்காட்டவும்"
        },
        {
          "id": "vcg3_3",
