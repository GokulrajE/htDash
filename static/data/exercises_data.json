          "description_ta": "பல மூட்டுகளுடன் ஒருங்கிணைந்த இயக்கம்"
        },
        {
          "id": "vcg4_5_6",
          "name": "Fine Motor Complex",
          "name_hi": "सूक्ष्म मोटर जटिल",
