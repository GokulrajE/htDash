          "description_ta": "கட்டைவிரல் மற்றும் விரலைக் கொடுக்கையாகப் பிடிக்கவும்"
        },
        {
          "id": "vcg3_4",
          "name": "Finger Wave",
          "name_hi": "उंगली हिलाव",
          "name_ta": "விரல் அசைக்க",
          "description": "Wave fingers side to side",
          "description_hi": "उंगलियों को आगे पीछे हिलाएं",
          "description_ta": "விரல்களை பக்கத்துக்கு அசைக்கவும்"
        },
        {
          "id": "vcg3_5",
          "name": "Finger Circle",
          "name_hi": "उंगली गोला",
          "name_ta": "விரல் வட்டம்",
          "description": "Make circles with finger",
          "description_hi": "उंगली से गोला बनाएं",
          "description_ta": "விரலால் வட்டம் வரைக்க"
        },
        {
          "id": "vcg3_6",
          "name": "Finger Touch",
          "name_hi": "उंगली स्पर्श",
          "name_ta": "விரல் தொடு",
          "description": "Touch thumb to each finger",
          "description_hi": "अंगूठे को हर उंगली से छुएं",
          "description_ta": "கட்டைவிரலை ஒவ்வொரு விரலாகத் தொடுக்க"
        }
      ]
    },
    "vcg4_5": {
