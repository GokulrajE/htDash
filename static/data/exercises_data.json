          "description": "Extend wrist downward",
          "description_hi": "कलाई को नीचे की ओर फैलाएं",
          "description_ta": "மணிக்கட்டைக் கீழ் நோக்கி நீட்டவும்"
        },
        {
          "id": "vcg2_3",
          "name": "Radial Deviation",
          "name_hi": "रेडियल विचलन",
          "name_ta": "ரேடியல் விலகல்",
          "description": "Move wrist toward thumb",
          "description_hi": "कलाई को अंगूठे की ओर ले जाएं",
          "description_ta": "மணிக்கட்டை கட்டைவிரல் நோக்கி நகர்த்தவும்"
        },
        {
          "id": "vcg2_4",
          "name": "Ulnar Deviation",
          "name_hi": "अल्नार विचलन",
          "name_ta": "அல்னர் விலகல்",
          "description": "Move wrist toward pinky",
          "description_hi": "कलाई को छोटी उंगली की ओर ले जाएं",
          "description_ta": "மணிக்கட்டைச் சிறியவிரல் நோக்கி நகர்த்தவும்"
        },
        {
          "id": "vcg2_5",
          "name": "Supination",
          "name_hi": "सुप्रेशन",
          "name_ta": "சுபினேஷன்",
          "description": "Rotate forearm palm up",
          "description_hi": "बांह को घुमाएं हथेली ऊपर",
          "description_ta": "முழுக்கைக்கு கீழே உள்ள பகுதியைச் சுற்றி உள்ளங்கை மேல் இருக்கச் சுற்றவும்"
        },
        {
          "id": "vcg2_6",
          "name": "Pronation",
          "name_hi": "प्रोनेशन",
          "name_ta": "ப்ரோனேஷன்",
          "description": "Rotate forearm palm down",
          "description_hi": "बांह को घुमाएं हथेली नीचे",
          "description_ta": "முழுக்கைக்கு கீழே உள்ள பகுதியைச் சுற்றி உள்ளங்கை கீழ் இருக்கச் சுற்றவும்"
        }
      ]
    },
    "vcg3": {
